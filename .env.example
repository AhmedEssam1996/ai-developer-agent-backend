# ============================================================================
# MyWork AI — environment configuration
# Copy to `.env` (backend) and/or `.env.local` (frontend). Never commit secrets.
# ============================================================================

# --- Core -------------------------------------------------------------------
APP_NAME=MyWork AI
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=   # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- URLs -------------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://mywork:mywork@localhost:5432/mywork
REDIS_URL=redis://localhost:6379/0

# --- AI gateway (OpenRouter) — server-side only -----------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Microsoft Graph (Outlook Mail/Calendar, Teams) -------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback

# --- GoodDay ----------------------------------------------------------------
GOODDAY_BASE_URL=https://api.goodday.work/1.0
GOODDAY_API_KEY=

# --- Integration behaviour --------------------------------------------------
# live = call real external APIs. mock = isolated development adapter.
INTEGRATION_MODE=mock
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=120

# --- Security ---------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
RATE_LIMIT_PER_MINUTE=120